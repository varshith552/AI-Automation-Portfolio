        "jsonBody": "={{ JSON.stringify({\n  model: \"qwen2.5:3b\",\n  stream: false,\n  options: { temperature: 0, num_ctx: 4096 },\n  format: {\n    type: \"object\",\n    properties: {\n      category: { type: \"string\", enum: [\"JOB_OPPORTUNITY\",\"INTERVIEW\",\"PROMOTIONAL\",\"GENERAL\"] },\n      reason: { type: \"string\" }\n    },\n    required: [\"category\",\"reason\"]\n  },\n  messages: [\n    {\n      role: \"system\",\n      content: \"Classify the email into exactly one category. Check in this order. 1. PROMOTIONAL: ads, discounts, offers, coupon codes, courses, training, products. 2. INTERVIEW: the sender invites the recipient to an interview or asks for interview availability. 3. JOB_OPPORTUNITY: a specific job opening or a request to apply. 4. GENERAL: everything else, including receipts, notifications, delivery failures, personal messages, and application acknowledgments. Use only the email text given. Do not invent details. Reason: one short sentence quoting words from the email.\"\n    },\n    {\n      role: \"user\",\n      content: \"Sender: \" + $json.sender + \"\\nSubject: \" + $json.subject + \"\\nBody: \" + String($json.body || $json.snippet || \"\").slice(0, 3000)\n    }\n  ]\n}) }}",
